{
  "manifest_version": 3,
  "name": "DAYCUBE Local Capture",
  "version": "0.1.0",
  "description": "Opt-in browser metadata for your local DAYCUBE vault. Disabled by default.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://127.0.0.1:7700/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}],
  "options_page": "options.html",
  "action": {"default_title": "DAYCUBE: open recording settings"},
  "incognito": "not_allowed"
}
