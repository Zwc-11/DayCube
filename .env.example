# Paths resolve relative to the repository, even when running from another folder.
DAYCUBE_VAULT_ROOT=vault
DAYCUBE_TIMEZONE=America/Toronto
DAYCUBE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Optional extension origin, visible at chrome://extensions after loading unpacked.
DAYCUBE_EXTENSION_ID=
# Local search works without any external accounts. These adapters are opt-in.
ANTHROPIC_API_KEY=
DAYCUBE_ANTHROPIC_MODEL=
# Language models for the day's review (docs/review.md), each off when empty: nothing leaves this PC
# and code alone writes. anthropic: the Anthropic API above; local: an OpenAI-compatible server on
# this PC (llama-server). CATEGORY labels apps and sites no rule knows (their names and up to three
# window titles); SUMMARY words the end-of-day review from the day's numbers and records.
DAYCUBE_CATEGORY_LLM=
DAYCUBE_SUMMARY_LLM=
# Yesterday's review on the phone each morning (docs/review.md): ntfy or telegram; empty is off.
DAYCUBE_SUMMARY_PUSH=
DAYCUBE_PUSH_AT=08:00
DAYCUBE_NTFY_URL=
DAYCUBE_TELEGRAM_TOKEN=
DAYCUBE_TELEGRAM_CHAT=
# The capture receiver restarts on new code (after git pull) when you are away; false: by hand.
DAYCUBE_AUTO_RESTART=true
DAYCUBE_LOCAL_LLM_URL=http://127.0.0.1:8080/v1
DAYCUBE_LOCAL_LLM_MODEL=local
HF_TOKEN=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
DAYCUBE_MODAL_APP=daycube
OVERPASS_URL=https://overpass-api.de/api/interpreter
