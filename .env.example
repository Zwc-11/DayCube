# Paths resolve relative to the repository, even when running from another folder.
DAYCUBE_VAULT_ROOT=vault
DAYCUBE_TIMEZONE=America/Toronto
DAYCUBE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Optional extension origin, visible at chrome://extensions after loading unpacked.
DAYCUBE_EXTENSION_ID=
# Local search works without any external accounts. These adapters are opt-in.
ANTHROPIC_API_KEY=
DAYCUBE_ANTHROPIC_MODEL=
HF_TOKEN=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
DAYCUBE_MODAL_APP=daycube
OVERPASS_URL=https://overpass-api.de/api/interpreter
