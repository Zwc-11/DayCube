{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Day", "type": "object", "additionalProperties": false,
  "required": ["schema", "date", "tz", "places", "transits", "cube_faces", "stats"],
  "properties": {
    "schema": {"const": "daycube.day/1"},
    "date": {"type": "string", "format": "date"},
    "tz": {"type": "string", "minLength": 1},
    "places": {"type": "array", "items": {"$ref": "#/$defs/Place"}},
    "transits": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to", "t0", "t1", "mode", "conf"],
      "properties": {
        "from": {"type": "string"}, "to": {"type": "string"},
        "t0": {"type": "string", "format": "date-time"}, "t1": {"type": "string", "format": "date-time"},
        "mode": {"enum": ["walk", "vehicle", "bike", "unknown"]},
        "conf": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }},
    "cube_faces": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"type": "string"}},
    "stats": {
      "type": "object", "additionalProperties": false,
      "required": ["events", "moments", "places", "floor_changes"],
      "properties": {
        "events": {"type": "integer", "minimum": 0}, "moments": {"type": "integer", "minimum": 0},
        "places": {"type": "integer", "minimum": 0}, "floor_changes": {"type": "integer", "minimum": 0}
      }
    },
    "summary": {"type": "string"}
  },
  "$defs": {
    "Place": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "kind", "t0", "t1", "lat", "lon", "floors_visited", "conf", "layer_index"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "name": {"type": "string", "minLength": 1}, "kind": {"enum": ["house", "cafe", "venue", "outdoor"]},
        "t0": {"type": "string", "format": "date-time"}, "t1": {"type": "string", "format": "date-time"},
        "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
        "lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
        "osm_id": {"type": ["string", "null"]}, "venue": {"type": ["string", "null"]},
        "floors_visited": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
        "conf": {"type": "number", "minimum": 0, "maximum": 1},
        "layer_index": {"type": "integer", "minimum": 0}
      }
    }
  }
}
