{
  "day": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Day",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "date",
      "tz",
      "places",
      "transits",
      "cube_faces",
      "stats"
    ],
    "properties": {
      "schema": {
        "const": "daycube.day/1"
      },
      "date": {
        "type": "string",
        "format": "date"
      },
      "tz": {
        "type": "string",
        "minLength": 1
      },
      "places": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Place"
        }
      },
      "transits": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to",
            "t0",
            "t1",
            "mode",
            "conf"
          ],
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "t0": {
              "type": "string",
              "format": "date-time"
            },
            "t1": {
              "type": "string",
              "format": "date-time"
            },
            "mode": {
              "enum": [
                "walk",
                "vehicle",
                "bike",
                "unknown"
              ]
            },
            "conf": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "cube_faces": {
        "type": "array",
        "maxItems": 6,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      },
      "stats": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "events",
          "moments",
          "places",
          "floor_changes"
        ],
        "properties": {
          "events": {
            "type": "integer",
            "minimum": 0
          },
          "moments": {
            "type": "integer",
            "minimum": 0
          },
          "places": {
            "type": "integer",
            "minimum": 0
          },
          "floor_changes": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "summary": {
        "type": "string"
      }
    },
    "$defs": {
      "Place": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "t0",
          "t1",
          "lat",
          "lon",
          "floors_visited",
          "conf",
          "layer_index"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "house",
              "cafe",
              "venue",
              "outdoor"
            ]
          },
          "t0": {
            "type": "string",
            "format": "date-time"
          },
          "t1": {
            "type": "string",
            "format": "date-time"
          },
          "lat": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -180,
            "maximum": 180
          },
          "osm_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "venue": {
            "type": [
              "string",
              "null"
            ]
          },
          "floors_visited": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer"
            }
          },
          "conf": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "layer_index": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "event": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Event",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "t",
      "type",
      "label",
      "source",
      "confidence",
      "fidelity"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "t": {
        "type": "string",
        "format": "date-time"
      },
      "t_end": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "type": {
        "enum": [
          "place.visit",
          "place.floor",
          "place.transit",
          "screen.app",
          "screen.page",
          "screen.read",
          "moment.video",
          "moment.audio",
          "said.quote",
          "git.push",
          "calendar.event"
        ]
      },
      "label": {
        "type": "string",
        "minLength": 1
      },
      "place": {
        "type": [
          "string",
          "null"
        ]
      },
      "floor": {
        "type": [
          "integer",
          "null"
        ]
      },
      "x": {
        "type": [
          "number",
          "null"
        ]
      },
      "y": {
        "type": [
          "number",
          "null"
        ]
      },
      "position_fidelity": {
        "enum": [
          "known",
          "estimated",
          "illustrative"
        ]
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "fidelity": {
        "enum": [
          "known",
          "estimated",
          "illustrative"
        ]
      },
      "attention": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0,
        "maximum": 1
      },
      "people": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "topics": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "text": {
        "type": "string"
      },
      "moment_id": {
        "type": "string"
      },
      "speaker": {
        "type": "string"
      },
      "app": {
        "type": "string"
      },
      "window_title": {
        "type": "string"
      },
      "url": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "scroll_depth": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "blocks": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "conf": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "from": {
        "type": "string"
      },
      "to": {
        "type": "string"
      },
      "mode": {
        "type": "string"
      },
      "repo": {
        "type": "string"
      },
      "commits": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "attendees": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "type": {
              "const": "said.quote"
            }
          }
        },
        "then": {
          "required": [
            "speaker",
            "text",
            "moment_id"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "enum": [
                "moment.video",
                "moment.audio"
              ]
            }
          }
        },
        "then": {
          "required": [
            "moment_id"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "screen.app"
            }
          }
        },
        "then": {
          "required": [
            "app",
            "window_title",
            "t_end"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "screen.page"
            }
          }
        },
        "then": {
          "required": [
            "url",
            "title",
            "scroll_depth"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "screen.read"
            }
          }
        },
        "then": {
          "required": [
            "blocks",
            "attention"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "place.visit"
            }
          }
        },
        "then": {
          "required": [
            "place",
            "conf"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "place.floor"
            }
          }
        },
        "then": {
          "required": [
            "place",
            "floor",
            "conf"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "place.transit"
            }
          }
        },
        "then": {
          "required": [
            "from",
            "to",
            "mode"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "git.push"
            }
          }
        },
        "then": {
          "required": [
            "repo",
            "commits"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "calendar.event"
            }
          }
        },
        "then": {
          "required": [
            "title",
            "attendees"
          ]
        }
      }
    ]
  },
  "graph": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Graph",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "nodes",
      "edges"
    ],
    "properties": {
      "nodes": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "person",
                "place",
                "topic",
                "moment",
                "event"
              ]
            },
            "label": {
              "type": "string"
            }
          }
        }
      },
      "edges": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to",
            "rel",
            "evidence"
          ],
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "rel": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "moment": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Moment",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "t0",
      "duration_s",
      "place",
      "camera",
      "fidelity",
      "media_available"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "title": {
        "type": "string"
      },
      "t0": {
        "type": "string",
        "format": "date-time"
      },
      "duration_s": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "lat": {
        "type": [
          "number",
          "null"
        ],
        "minimum": -90,
        "maximum": 90
      },
      "lon": {
        "type": [
          "number",
          "null"
        ],
        "minimum": -180,
        "maximum": 180
      },
      "place": {
        "type": [
          "string",
          "null"
        ]
      },
      "floor": {
        "type": [
          "integer",
          "null"
        ]
      },
      "camera": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fov_deg"
        ],
        "properties": {
          "fov_deg": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 180
          }
        }
      },
      "fidelity": {
        "enum": [
          "known",
          "estimated",
          "illustrative"
        ]
      },
      "media_available": {
        "type": "boolean"
      },
      "consented_people": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "ocr": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Ocr",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "shot",
      "t",
      "app",
      "title",
      "w",
      "h",
      "blocks"
    ],
    "properties": {
      "shot": {
        "type": "string"
      },
      "t": {
        "type": "string",
        "format": "date-time"
      },
      "app": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "w": {
        "type": "integer",
        "minimum": 1
      },
      "h": {
        "type": "integer",
        "minimum": 1
      },
      "blocks": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "bbox",
            "text",
            "conf",
            "attention",
            "dwell_ms"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "bbox": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "minItems": 4,
              "maxItems": 4
            },
            "text": {
              "type": "string"
            },
            "conf": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "attention": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "dwell_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "review": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Review",
    "description": "vault/<date>/review.json: the end-of-day summary of a review day (04:00 to 04:00 local). Every number comes from code; the words come from a template or a language model whose output passed the validator. Every cited id is a key of evidence.",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "date",
      "zone",
      "kind",
      "made",
      "window",
      "writer",
      "facts",
      "headline",
      "sentences",
      "numbers",
      "categories",
      "done",
      "improvements",
      "tomorrow",
      "evidence",
      "gaps",
      "illustrative"
    ],
    "properties": {
      "schema": {
        "const": "daycube.review/1"
      },
      "date": {
        "type": "string",
        "format": "date"
      },
      "zone": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "enum": [
          "draft",
          "final"
        ],
        "description": "draft: written before the review day ended (23:00, or on request); final: after it."
      },
      "made": {
        "type": "string",
        "format": "date-time"
      },
      "window": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "t0",
          "t1"
        ],
        "properties": {
          "t0": {
            "type": "string",
            "format": "date-time"
          },
          "t1": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "writer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "attempts",
          "rejected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "template, or the model that wrote the words."
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "rejected": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Why the validator rejected a model's answer."
          }
        }
      },
      "facts": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$",
        "description": "Hash of the facts the review was written from: the same facts are never written twice."
      },
      "headline": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "sentences": {
        "type": "array",
        "description": "At most 8 (the writer and its validator hold to it).",
        "items": {
          "$ref": "#/$defs/Cited"
        }
      },
      "numbers": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "label",
            "display",
            "value",
            "evidence"
          ],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "display": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "evidence": {
              "$ref": "#/$defs/Ids"
            }
          }
        }
      },
      "categories": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "seconds",
            "share",
            "display",
            "evidence"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "seconds": {
              "type": "number",
              "minimum": 0
            },
            "share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "display": {
              "type": "string"
            },
            "evidence": {
              "$ref": "#/$defs/Ids"
            }
          }
        }
      },
      "apps": {
        "type": "array",
        "description": "Phone apps by time, from iOS Shortcuts' opened and closed events (share: of the phone time).",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "seconds",
            "share",
            "display",
            "evidence"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "seconds": {
              "type": "number",
              "minimum": 0
            },
            "share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "display": {
              "type": "string"
            },
            "evidence": {
              "$ref": "#/$defs/Ids"
            }
          }
        }
      },
      "plan": {
        "type": "array",
        "description": "Blocks planned in the daily note's Plan section or the calendar files, against what the day was.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "status",
            "from",
            "to",
            "source",
            "evidence"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "done",
                "partly",
                "elsewhere",
                "missed"
              ]
            },
            "from": {
              "type": "string",
              "format": "date-time"
            },
            "to": {
              "type": "string",
              "format": "date-time"
            },
            "source": {
              "enum": [
                "note",
                "calendar"
              ]
            },
            "evidence": {
              "$ref": "#/$defs/Ids"
            }
          }
        }
      },
      "done": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "kind",
            "evidence"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "project",
                "commits",
                "site",
                "read"
              ]
            },
            "evidence": {
              "$ref": "#/$defs/Ids"
            }
          }
        }
      },
      "improvements": {
        "type": "array",
        "description": "At most 3, each tied to a number or a category by its key.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "metric",
            "evidence"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "metric": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "$ref": "#/$defs/Ids"
            }
          }
        }
      },
      "tomorrow": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "kind",
            "due",
            "evidence"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "deadline",
                "resume",
                "hours"
              ]
            },
            "due": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 10,
              "description": "A deadline's date, or date and local time."
            },
            "evidence": {
              "$ref": "#/$defs/Ids"
            }
          }
        }
      },
      "evidence": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t",
            "until",
            "day",
            "kind",
            "text",
            "fidelity"
          ],
          "properties": {
            "t": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "until": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "day": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "kind": {
              "type": "string",
              "minLength": 1,
              "description": "timeline (a segment of the day's timeline) or the type of the search unit."
            },
            "text": {
              "type": "string"
            },
            "fidelity": {
              "enum": [
                "known",
                "estimated",
                "illustrative"
              ]
            },
            "records": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "A segment's first records (capture:app:..., place:...), at most 5."
            }
          }
        }
      },
      "gaps": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "What the review could not see: unrecorded sources, known limits of the day's records."
      },
      "illustrative": {
        "type": "boolean",
        "description": "Some of the records behind it are synthetic or sample data."
      }
    },
    "$defs": {
      "Ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "Cited": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidence"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "skeleton": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Skeleton",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "type",
      "features"
    ],
    "properties": {
      "type": {
        "const": "FeatureCollection"
      },
      "features": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "geometry",
            "properties"
          ],
          "properties": {
            "type": {
              "const": "Feature"
            },
            "geometry": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "Point"
                },
                "coordinates": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "properties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "t",
                "place",
                "floor",
                "x",
                "y",
                "pos_conf",
                "fidelity",
                "source"
              ],
              "properties": {
                "t": {
                  "type": "string",
                  "format": "date-time"
                },
                "alt_rel": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "floor": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "floor_conf": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "place": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "x": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "y": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "pos_conf": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "fidelity": {
                  "enum": [
                    "known",
                    "estimated",
                    "illustrative"
                  ]
                },
                "source": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "timeline": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "TimelineSegment",
    "description": "One line of vault/<date>/timeline.jsonl: a stretch of the review day (04:00 to 04:00 local) spent in one place doing one kind of thing. Time the computer and phone did not record has no segment.",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "t",
      "until",
      "where",
      "doing",
      "category",
      "project",
      "talk",
      "switches",
      "evidence",
      "source",
      "fidelity",
      "labeled",
      "key",
      "broad"
    ],
    "properties": {
      "t": {
        "type": "string",
        "format": "date-time"
      },
      "until": {
        "type": "string",
        "format": "date-time"
      },
      "where": {
        "type": "string",
        "pattern": "^(desk|away|unknown|place:[A-Za-z0-9_-]+)$"
      },
      "doing": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "description": "At the desk only: coding, studying, ... or other."
      },
      "project": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "talk": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "description": "Moment ids of conversations recorded during the segment."
      },
      "switches": {
        "type": "integer",
        "minimum": 0,
        "description": "Times something else was in front for under 20 s and the segment went on."
      },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "Ids of the records the segment was made from: capture:app:<id>, capture:visit:<id>, capture:away:<id>, capture:media:<id>, place:<id>, event ids."
      },
      "source": {
        "enum": [
          "pc",
          "phone",
          "pc+phone"
        ]
      },
      "fidelity": {
        "enum": [
          "known",
          "estimated",
          "illustrative"
        ],
        "description": "illustrative: made from synthetic or sample records."
      },
      "labeled": {
        "anyOf": [
          {
            "enum": [
              "correction",
              "rule",
              "cache",
              "llm",
              "none"
            ]
          },
          {
            "type": "null"
          }
        ],
        "description": "How the category was decided; null away from the desk."
      },
      "key": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "description": "At the desk: the window or page in front longest (page:<url> or app:<program>|<title>), the key a correction of just it uses."
      },
      "broad": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "description": "Its site or app (site:<domain> or app:<program>), the key a correction of all of it uses."
      }
    }
  },
  "transcript": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Transcript",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "segments",
      "speaker_map"
    ],
    "properties": {
      "speaker_map": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "segments": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end",
            "text",
            "speaker",
            "words"
          ],
          "properties": {
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "minimum": 0
            },
            "text": {
              "type": "string"
            },
            "speaker": {
              "type": [
                "string",
                "null"
              ]
            },
            "words": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "word",
                  "start",
                  "end"
                ],
                "properties": {
                  "word": {
                    "type": "string"
                  },
                  "start": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end": {
                    "type": "number",
                    "minimum": 0
                  },
                  "score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "venue": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Venue",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "id",
      "name",
      "entrance",
      "axis_deg",
      "floor_height_m",
      "floors",
      "levels"
    ],
    "properties": {
      "schema": {
        "const": "daycube.venue/1"
      },
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "entrance": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lat",
          "lon"
        ],
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "axis_deg": {
        "type": "number"
      },
      "floor_height_m": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "floors": {
        "type": "integer",
        "minimum": 1
      },
      "levels": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "walls",
            "doors",
            "stairs",
            "rooms",
            "graph"
          ],
          "properties": {
            "index": {
              "type": "integer"
            },
            "walls": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Segment"
              }
            },
            "doors": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Segment"
              }
            },
            "stairs": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "rooms": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "poly",
                  "kind"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "poly": {
                    "type": "array",
                    "minItems": 3,
                    "items": {
                      "$ref": "#/$defs/Point"
                    }
                  },
                  "kind": {
                    "type": "string"
                  }
                }
              }
            },
            "graph": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "nodes",
                "edges"
              ],
              "properties": {
                "nodes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Point"
                  }
                },
                "edges": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              }
            }
          }
        }
      },
      "wifi": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bssid",
            "x",
            "y",
            "floor",
            "rssi"
          ],
          "properties": {
            "bssid": {
              "type": "string"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "floor": {
              "type": "integer"
            },
            "rssi": {
              "type": "number"
            }
          }
        }
      }
    },
    "$defs": {
      "Point": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "Segment": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Point"
        },
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "week": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Week",
    "description": "vault/weeks/<YYYY-Www>.json: a week (Monday to Sunday) in numbers, from the days' timelines and reviews. Written once Sunday's review day has ended, and again when a day of the week changes.",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "week",
      "from",
      "to",
      "zone",
      "made",
      "days",
      "totals",
      "categories",
      "projects",
      "previous",
      "best_hours",
      "next"
    ],
    "properties": {
      "schema": {
        "const": "daycube.week/1"
      },
      "week": {
        "type": "string",
        "pattern": "^[0-9]{4}-W[0-9]{2}$"
      },
      "from": {
        "type": "string",
        "format": "date"
      },
      "to": {
        "type": "string",
        "format": "date"
      },
      "zone": {
        "type": "string",
        "minLength": 1
      },
      "made": {
        "type": "string",
        "format": "date-time"
      },
      "days": {
        "type": "array",
        "minItems": 7,
        "maxItems": 7,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "desk_s",
            "focus",
            "focus_s",
            "longest_s",
            "category",
            "project",
            "phone",
            "pickups",
            "commits",
            "keys",
            "review"
          ],
          "properties": {
            "date": {
              "type": "string",
              "format": "date"
            },
            "desk_s": {
              "type": "number",
              "minimum": 0
            },
            "focus": {
              "type": "integer",
              "minimum": 0
            },
            "focus_s": {
              "type": "number",
              "minimum": 0
            },
            "longest_s": {
              "type": "number",
              "minimum": 0
            },
            "category": {
              "type": [
                "string",
                "null"
              ]
            },
            "project": {
              "type": [
                "string",
                "null"
              ]
            },
            "phone": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "pickups": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "commits": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "keys": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "review": {
              "enum": [
                "draft",
                "final",
                null
              ],
              "description": "The day's review, if it has one."
            }
          }
        }
      },
      "totals": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "desk_s",
          "focus",
          "focus_s",
          "phone",
          "pickups",
          "commits",
          "keys",
          "days_recorded"
        ],
        "properties": {
          "desk_s": {
            "type": "number",
            "minimum": 0
          },
          "focus": {
            "type": "number",
            "minimum": 0
          },
          "focus_s": {
            "type": "number",
            "minimum": 0
          },
          "phone": {
            "type": [
              "number",
              "null"
            ]
          },
          "pickups": {
            "type": [
              "number",
              "null"
            ]
          },
          "commits": {
            "type": [
              "number",
              "null"
            ]
          },
          "keys": {
            "type": [
              "number",
              "null"
            ]
          },
          "days_recorded": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          }
        }
      },
      "categories": {
        "$ref": "#/$defs/Shares"
      },
      "projects": {
        "$ref": "#/$defs/Shares"
      },
      "previous": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "required": [
          "desk_s",
          "focus",
          "focus_s"
        ],
        "description": "The week before, for comparison; null when nothing was recorded then.",
        "properties": {
          "desk_s": {
            "type": "number"
          },
          "focus": {
            "type": "number"
          },
          "focus_s": {
            "type": "number"
          }
        }
      },
      "best_hours": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "stretches"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-9]{2}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-9]{2}$"
          },
          "stretches": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "next": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "due"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "due": {
              "type": "string",
              "minLength": 10
            }
          }
        }
      }
    },
    "$defs": {
      "Shares": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "seconds",
            "share"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "seconds": {
              "type": "number",
              "minimum": 0
            },
            "share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}
